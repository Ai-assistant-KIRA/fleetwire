SHELL := /bin/bash
.SHELLFLAGS := -eu -o pipefail -c
.DEFAULT_GOAL := help

GO      ?= go
PKG     := github.com/Ai-assistant-KIRA/fleetwire
VERSION ?= $(shell git describe --tags --always --dirty 2>/dev/null || echo dev)
COMMIT  ?= $(shell git rev-parse HEAD 2>/dev/null || echo unknown)
DATE    ?= $(shell date -u +%Y-%m-%dT%H:%M:%SZ)
LDFLAGS := -s -w \
	-X $(PKG)/internal/buildinfo.Version=$(VERSION) \
	-X $(PKG)/internal/buildinfo.Commit=$(COMMIT) \
	-X $(PKG)/internal/buildinfo.Date=$(DATE)
BINARIES := $(notdir $(wildcard cmd/*))
FUZZTIME ?= 30s

.PHONY: help
help: ## Show this help
	@awk 'BEGIN {FS = ":.*## "} /^[a-zA-Z0-9_-]+:.*## / {printf "  %-14s %s\n", $$1, $$2}' $(MAKEFILE_LIST)

.PHONY: fmt
fmt: ## Format Go code
	gofmt -s -w $$(git ls-files '*.go' 2>/dev/null || find . -name '*.go' -not -path './internal/gen/*')

.PHONY: lint
lint: ## Run gofmt check, go vet and golangci-lint
	@unformatted=$$(gofmt -s -l $$(find . -name '*.go' -not -path './internal/gen/*')); \
	if [ -n "$$unformatted" ]; then echo "gofmt needed:"; echo "$$unformatted"; exit 1; fi
	$(GO) vet ./...
	golangci-lint run ./...

.PHONY: test
test: ## Run unit tests (integration tests skip when Docker is missing)
	$(GO) test -count=1 ./...

.PHONY: test-race
test-race: ## Run all tests with the race detector
	$(GO) test -count=1 -race ./...

.PHONY: fuzz-smoke
fuzz-smoke: ## Run every fuzz target for FUZZTIME (default 30s)
	./scripts/fuzz-smoke.sh $(FUZZTIME)

.PHONY: generate
generate: ## Regenerate protobuf code
	buf generate
	gofmt -s -w internal/gen

.PHONY: check-generated
check-generated: generate ## Fail if generated code is out of date
	@git diff --exit-code -- internal/gen || (echo "generated code is stale: run make generate" && exit 1)

.PHONY: build
build: ## Build every binary into bin/
	@mkdir -p bin
	@for b in $(BINARIES); do \
		echo "go build $$b"; \
		CGO_ENABLED=0 $(GO) build -trimpath -ldflags "$(LDFLAGS)" -o bin/$$b ./cmd/$$b; \
	done
	@[ -n "$(BINARIES)" ] || $(GO) build ./...

.PHONY: vuln
vuln: ## Scan dependencies for known vulnerabilities
	govulncheck ./...

.PHONY: rules-test
rules-test: ## Check the Prometheus rules and run their unit tests
	promtool check rules deploy/prometheus/rules/*.yml
	promtool test rules deploy/prometheus/tests/*.yml

.PHONY: docs-reference
docs-reference: build ## Regenerate docs/reference/configuration.md from the config structs
	@{ \
	  echo "# Configuration"; echo; \
	  echo "Generated by \`make docs-reference\` from the configuration structs; do not edit."; echo; \
	  echo "## fleetwire-agent (snap keys)"; echo; bin/fleetwire-agent config docs; echo; \
	  echo "## fleetwire-api"; echo; bin/fleetwire-api config-docs; echo; \
	  echo "## fleetwire-bridge"; echo; bin/fleetwire-bridge config-docs; echo; \
	  echo "## fleetwire-ingest"; echo; bin/fleetwire-ingest config-docs; \
	} > docs/reference/configuration.md

.PHONY: docs
docs: ## Build the Sphinx documentation into docs/_build/html
	python3 -m venv .cache/docs-venv
	.cache/docs-venv/bin/pip install -q -r docs/requirements.txt
	.cache/docs-venv/bin/sphinx-build -W --keep-going -b html docs docs/_build/html

.PHONY: snap
snap: ## Build the agent snap (snapcraft with the LXD backend)
	snapcraft pack

# ---- Local stack ----------------------------------------------------------

COMPOSE := docker compose -f deploy/compose/compose.yaml
STATE   := deploy/compose/.state
SECRETS := deploy/compose/secrets
# Containers run as the user who starts the stack, so they can read the
# dev secrets (0400) that dev-ca wrote for that user.
export FW_UID := $(shell id -u)
export FW_GID := $(shell id -g)

.PHONY: dev-ca
dev-ca: ## Create the development CA and certificates (idempotent, never overwrites)
	$(GO) run ./scripts/dev-ca -out $(SECRETS) -hosts localhost,127.0.0.1,10.0.2.2,mosquitto,toxiproxy,api

.PHONY: up
up: dev-ca ## Build the images and start the development stack
	mkdir -p $(STATE)/keyring $(STATE)/crl $(STATE)/exports $(STATE)/mosquitto
	@# Compose reads .env itself, so plain `docker compose` calls (the chaos
	@# runner, a developer by hand) run the containers as the same user.
	printf 'FW_UID=%s\nFW_GID=%s\n' "$(FW_UID)" "$(FW_GID)" > deploy/compose/.env
	[ -f $(STATE)/crl/crl.pem ] || cp $(SECRETS)/crl.pem $(STATE)/crl/crl.pem
	$(COMPOSE) up -d --build --wait --wait-timeout 300

.PHONY: down
down: ## Stop the stack and keep its data
	$(COMPOSE) down

.PHONY: reset
reset: ## Stop the stack and delete all of its data (keeps the dev CA)
	$(COMPOSE) down -v --remove-orphans
	rm -rf $(STATE)

.PHONY: ps
ps: ## Show the stack's containers
	$(COMPOSE) ps

.PHONY: logs
logs: ## Follow the logs of the fleetwire services
	$(COMPOSE) logs -f api bridge-1 bridge-2 ingest-1 ingest-2

.PHONY: operator-token
operator-token: ## Print a new operator token (shown once)
	@$(COMPOSE) run --rm --no-deps -T migrate create-operator-token -name "$${NAME:-operator-$$(date +%s)}"

.PHONY: demo
demo: build up ## Start the stack, enroll 5 agents, send data for 60 s, show where to look
	./scripts/demo.sh

.PHONY: demo-stop
demo-stop: ## Stop the demo agents
	./scripts/demo.sh stop

.PHONY: e2e
e2e: build up ## Run the end-to-end tests against the running stack
	FLEETWIRE_E2E=1 $(GO) test -count=1 -timeout 15m ./test/e2e/...

.PHONY: clean
clean: ## Remove build output
	rm -rf bin dist
