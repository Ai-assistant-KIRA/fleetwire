#!/bin/sh
# Command chain of both apps. snapd starts the daemon as root, and sudo
# runs the fleetwire-agent command as root; both continue here as the
# snap_daemon system user (uid and gid 584788 on every system). Apart from
# prepare-state, which only creates, moves and hands over, no process of
# the snap reads or writes $SNAP_DATA/state as root, so none leaves a
# root-owned file there that the daemon could not open.
#
# The agent binary drops the privileges itself (`fleetwire-agent
# drop-privileges`): it clears the supplementary groups, sets every gid and
# uid to snap_daemon, and execs the command, which starts with no
# capabilities. setpriv from the base would do the same, but snapd before
# 2.68, which Ubuntu Core 24 ships, does not let a snap execute it.
set -eu
if [ "$(id -u)" -eq 0 ]; then
  exec "$SNAP/bin/fleetwire-agent" drop-privileges "$@"
fi
exec "$@"
