  "panels": [
    {
      "type": "row",
      "title": "Delivery guarantee",
      "collapsed": false,
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Readings stored per second",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(fleetwire_ingest_readings_stored_total[1m]))",
          "legendFormat": "stored"
        },
        {
          "refId": "B",
          "expr": "sum(rate(fleetwire_agent_readings_collected_total[1m]))",
          "legendFormat": "collected (load generator)"
        }
      ],
      "gridPos": {
        "w": 8,
        "h": 8,
        "x": 0,
        "y": 1
      },
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "End-to-end delay (collect to commit)",
