{
  "uid": "fleetwire",
  "title": "fleetwire",
  "tags": [
    "fleetwire"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
